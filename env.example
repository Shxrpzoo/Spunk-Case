# Supabase Connect > Transaction pooler URI. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
# Exact public address, no trailing slash; http://localhost:3000 for local development.
APP_ORIGIN=http://localhost:3000
# Share with friends to create a player; use a long random value.
INVITE_CODE=replace-with-a-long-random-invite
# Generate with npm run admin:password. Never use a NEXT_PUBLIC_ prefix.
ADMIN_PASSWORD_HASH=replace-with-generated-hash
# Set true only for a local non-production test database; never for Vercel.
USE_LOCAL_DB=false
